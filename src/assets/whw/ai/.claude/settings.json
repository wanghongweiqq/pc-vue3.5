{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Skill(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch(*)",
      "WebSearch(*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/project-guard-check.sh",
            "statusMessage": "project-guard 检查中..."
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "echo thinking > /tmp/claude_status"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "echo thinking > /tmp/claude_status"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo confirming > /tmp/claude_status"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff 2>/dev/null || printf '\\a'; echo waiting > /tmp/claude_status"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 1
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "思考中",
      "分析中",
      "处理中",
      "理解中",
      "规划中",
      "搜索中",
      "检查中",
      "生成中"
    ]
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Run python3 ~/.claude/skills/team-lead/launch-single-role.py to start a single AI team role window with background role-agent.sh",
      "Run python3 ~/.claude/skills/team-lead/launch_team.py to start all AI team role windows with background agents"
    ]
  }
}
